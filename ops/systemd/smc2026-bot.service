[Unit]
Description=SMC2026 BTCUSDT Mainnet Tier-S shadow bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/SMC2026
ExecStartPre=/usr/bin/python3 /home/ubuntu/SMC2026/ops/repo_integrity_check.py
ExecStart=/usr/bin/python3 /home/ubuntu/SMC2026/mainnet_tier_s_shadow_risk_launcher.py
Restart=always
RestartSec=5s
RestartPreventExitStatus=73
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SMC_EXECUTION_VENUE=MAINNET
Environment=SMC_ENABLE_TRADING=false
Environment=SMC_MAINNET_ARMED=false
Environment=SMC_MAINNET_EXCLUSIVE_ACCOUNT=false
Environment=SMC_FIXED_QTY_BTC=0.001
Environment=SMC_LEVERAGE=20
Environment=SMC_MARGIN_TYPE=ISOLATED
Environment=SMC_SHADOW_BALANCE_USDT=5.4
Environment=SMC_SHADOW_FEE_BPS_PER_SIDE=5.0
Environment=SMC_RECORDER_POLICY=DISABLED
Environment=SMC_CONTINUOUS_SHADOW=0
Environment=SMC_SIDE_CALIBRATION_MODE=OFF
Environment=SMC_ML_META_MODE=OFF
Environment=SMC_JOURNAL_DIR=/home/ubuntu/.local/state/smc2026/mainnet_shadow
Environment=SMC_SHADOW_EVENTS_PATH=/home/ubuntu/.local/state/smc2026/mainnet_shadow/events.jsonl
UMask=0077
CPUAccounting=true
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/smc2026 /home/ubuntu/smc2026_data/health /home/ubuntu/SMC2026/3_thuc_thi/quan_ly_vi_the/rom_backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=default.target
