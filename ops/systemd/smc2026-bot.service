[Unit]
Description=SMC2026 BTCUSDT Mainnet bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/SMC2026
ExecStart=/usr/bin/python3 /home/ubuntu/SMC2026/khoi_dong.py
Restart=always
RestartSec=5s
RestartPreventExitStatus=73
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SMC_EXECUTION_VENUE=MAINNET
Environment=SMC_MAINNET_EXCLUSIVE_ACCOUNT=true
Environment=SMC_MAINNET_ARMED=true
Environment=SMC_ENABLE_TRADING=true
Environment=SMC_STRATEGY_PROFILE=AUG13_EARLY_HYBRID_V1
Environment=SMC_FIXED_QTY_BTC=0.001
Environment=SMC_LEVERAGE=20
Environment=SMC_MARGIN_TYPE=ISOLATED
Environment=SMC_MAX_FILLED_ENTRIES_PER_VN_DAY=8
Environment=SMC_DAILY_NET_LOSS_USDT=0.30
Environment=SMC_MAX_CONSECUTIVE_LOSSES=2
Environment=SMC_MAX_PLANNED_LOSS_USDT=0.12
Environment=SMC_LOSS_STREAK_COOLDOWN_SECONDS=36000
Environment=SMC_MAINNET_MAKER_MIN_NET_EDGE_BPS=2.0
Environment=SMC_MAINNET_MARKET_MIN_NET_EDGE_BPS=6.0
Environment=SMC_MAINNET_STOP_SLIPPAGE_FLOOR_BPS=3.0
Environment=SMC_MAINNET_MARGIN_RESERVE_USDT=0.50
Environment=SMC_PASSIVE_ENTRY_FEE_BPS=2.0
Environment=SMC_SHADOW_ENTRY_FEE_BPS=5.0
Environment=SMC_SHADOW_EXIT_FEE_BPS=5.0
Environment=SMC_PASSIVE_REPRICE_MAX=8
Environment=SMC_RECORDER_POLICY=DISABLED
Environment=SMC_MINIMAL_MAINNET_AUDIT=true
Environment=SMC_CONTINUOUS_SHADOW=0
Environment=SMC_SIDE_CALIBRATION_MODE=OFF
Environment=SMC_ML_META_MODE=OFF
Environment=SMC_JOURNAL_DIR=/home/ubuntu/.local/state/smc2026/mainnet
Environment=SMC_JOURNAL_EVENTS_PATH=/home/ubuntu/.local/state/smc2026/mainnet/events.jsonl
Environment=SMC_MAINNET_SAFETY_STATE_PATH=/home/ubuntu/.local/state/smc2026/mainnet/safety_state.json
LoadCredential=binance_api_key:/home/ubuntu/.config/smc2026/credentials/binance_api_key
LoadCredential=binance_api_secret:/home/ubuntu/.config/smc2026/credentials/binance_api_secret
UMask=0077
CPUAccounting=true
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/smc2026 /home/ubuntu/smc2026_data/health /home/ubuntu/SMC2026/3_thuc_thi/quan_ly_vi_the/rom_backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=default.target
