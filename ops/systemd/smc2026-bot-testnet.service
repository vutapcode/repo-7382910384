[Unit]
Description=SMC2026 BTCUSDT Testnet Tier-S bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/SMC2026
ExecStartPre=/usr/bin/python3 /home/ubuntu/SMC2026/ops/repo_integrity_check.py
ExecStart=/usr/bin/python3 /home/ubuntu/SMC2026/testnet_tier_s_launcher.py
Restart=always
RestartSec=5s
RestartPreventExitStatus=73
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=SMC_EXECUTION_VENUE=TESTNET
Environment=SMC_ENABLE_TRADING=true
Environment=SMC_FIXED_QTY_BTC=0.001
Environment=SMC_LEVERAGE=20
Environment=SMC_MARGIN_TYPE=ISOLATED
Environment=SMC_RECORDER_POLICY=DISABLED
Environment=SMC_CONTINUOUS_SHADOW=0
Environment=SMC_SIDE_CALIBRATION_MODE=OFF
Environment=SMC_ML_META_MODE=OFF
Environment=SMC_JOURNAL_DIR=/home/ubuntu/.local/state/smc2026/testnet
Environment=SMC_JOURNAL_EVENTS_PATH=/home/ubuntu/.local/state/smc2026/testnet/events.jsonl
LoadCredential=binance_api_key:/home/ubuntu/.config/smc2026/credentials/binance_testnet_api_key
LoadCredential=binance_api_secret:/home/ubuntu/.config/smc2026/credentials/binance_testnet_api_secret
UMask=0077
CPUAccounting=true
MemoryAccounting=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/smc2026 /home/ubuntu/smc2026_data/health /home/ubuntu/SMC2026/3_thuc_thi/quan_ly_vi_the/rom_backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=default.target
