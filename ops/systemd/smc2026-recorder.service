[Unit]
Description=SMC2026 read-only Binance market recorder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/SMC2026
ExecStart=/usr/bin/python3 -m recorder.main
Restart=always
RestartSec=3s
RestartPreventExitStatus=73
Environment=PYTHONUNBUFFERED=1
Environment=SMC_RECORDER_DATA_ROOT=/home/ubuntu/smc2026_data
Environment=SMC_RECORDER_SYMBOL=BTCUSDT
Environment=SMC_RECORDER_RETENTION_HOURS=24
Environment=SMC_RECORDER_RETENTION_SECONDS=60
UMask=0077
Nice=5
CPUAccounting=true
CPUQuota=10%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/smc2026_data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=256M
MemoryMax=512M
LimitNOFILE=4096

[Install]
WantedBy=default.target
