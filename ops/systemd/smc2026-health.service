[Unit]
Description=SMC2026 out-of-process operational health supervisor
After=network-online.target smc2026-bot.service
Wants=network-online.target smc2026-bot.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/WStrade
ExecStart=/home/ubuntu/WStrade/.venv/bin/python -m loi_he_thong.ops_supervisor_entrypoint
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1
Environment=SMC_RECORDER_DATA_ROOT=/home/ubuntu/smc2026_data
Environment=SMC_RECORDER_POLICY=DISABLED
UMask=0077
Nice=5
CPUQuota=5%
MemoryHigh=96M
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/smc2026_data/health
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=256

[Install]
WantedBy=default.target
