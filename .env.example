# Non-secret runtime configuration. Binance credentials belong in
# /etc/wstrade/credentials and are loaded by systemd, never by dotenv.
SMC_ENABLE_TRADING=false
SMC_MAINNET_ARMED=false
SMC_MAINNET_EXCLUSIVE_ACCOUNT=false
WSTRADE_MODE=DIRECT_LIVE
WSTRADE_IGNITION_MANUAL_APPROVAL=false
WSTRADE_QTY_BTC=0.001
WSTRADE_LEVERAGE=20
WSTRADE_MARGIN_TYPE=ISOLATED
WSTRADE_DAILY_LOSS_USDT=0.60
WSTRADE_MAX_PLANNED_LOSS_USDT=0.60
WSTRADE_MARGIN_RESERVE_USDT=0.50
WSTRADE_MAX_ENTRIES_PER_DAY=0
WSTRADE_MAX_CONSECUTIVE_LOSSES=0
WSTRADE_CPU_TARGET_PCT=24
WSTRADE_CPU_P95_PCT=26
WSTRADE_CPU_HARD_PCT=30
WSTRADE_CPU_WINDOWS_SECONDS=900,3600
WSTRADE_WAVEFRONT_SHADOW=1
WSTRADE_LIGHTSAIL_INSTANCE_NAME=
AWS_REGION=
